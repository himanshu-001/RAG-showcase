# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and configure your secrets:
#   cp .env.example .env
# ==============================================================================

# Google AI Studio / Gemini API Key
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=

# Default Model Configuration
# Available models: gemini-3.5-flash-lite, gemma-4-31b-it, gemma-4-26b-a4b-it, gemini-2.5-flash-lite, qwen2.5:0.5b
DEFAULT_MODEL=gemini-3.5-flash-lite

# Local Ollama Configuration
# When running on host: http://localhost:11434
# When running in Docker: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Model Configuration
# Options: all-minilm (Local Ollama, 0 cost, no quota limit), models/gemini-embedding-001 (Google AI Studio)
EMBEDDING_MODEL=all-minilm

# Google AI Studio Embedding Rate Limiting & Throttling
# Presets: free_tier (safe 30k TPM, 40 RPM, 15 batch), paid_tier (500k TPM, 300 RPM, 50 batch), custom
GOOGLE_EMBEDDING_PRESET=free_tier
GOOGLE_EMBEDDING_BATCH_SIZE=15
GOOGLE_EMBEDDING_DELAY_SEC=1.2
GOOGLE_EMBEDDING_RPM_LIMIT=40
GOOGLE_EMBEDDING_TPM_LIMIT=30000
GOOGLE_EMBEDDING_MAX_RETRIES=5
GOOGLE_EMBEDDING_MAX_BACKOFF=65.0
GOOGLE_EMBEDDING_CACHE_ENABLED=true

# Port Configurations (Optional overrides)
FASTAPI_PORT=8080
STREAMLIT_PORT=8501

# Test Mode (set to true to run offline tests with mock models)
TEST_MODE=false
